# ---- Warehouse: BigQuery ----
GCP_PROJECT=

# Copy to .env and fill in. Never commit the real file.
# Placeholder demos need none of these.

LANDING_DIR=sample_data/exports

# ---- Open Dental (developer key from Open Dental; one customer key per office) ----
OPEN_DENTAL_DEVELOPER_KEY=
OPEN_DENTAL_CUSTOMER_KEYS=1:customerkey,2:customerkey,4:customerkey,7:customerkey

# ---- Dentrix Ascend (after Henry Schein One API Exchange approval) ----
ASCEND_API_BASE=
ASCEND_TOKEN_URL=
ASCEND_CLIENT_ID=
ASCEND_CLIENT_SECRET=

# ---- Sensei Cloud scheduled report exports (local folder or sftp://user@host/path) ----
SENSEI_PROC_DROP=
SENSEI_PAY_DROP=
SENSEI_PROV_DROP=
SENSEI_PROC_SFTP_PASSWORD=

# ---- Dolphin Management (read-only SQL login) ----
DOLPHIN_ODBC=DRIVER={ODBC Driver 18 for SQL Server};SERVER=host;DATABASE=Dolphin;UID=readonly;PWD=;Encrypt=yes

# ---- Dentrix G-series (DDP read-only views over ODBC, run on a PC in the office) ----
DENTRIX_ODBC=
# ---- Dental Office Xpress report exports ----
DOX_PROC_DROP=
DOX_PAY_DROP=
DOX_PROV_DROP=
# ---- TDO Cloud report exports ----
TDO_PROC_DROP=
TDO_PAY_DROP=
TDO_PROV_DROP=

# ---- Sage Intacct Web Services ----
INTACCT_SENDER_ID=
INTACCT_SENDER_PASSWORD=
INTACCT_COMPANY_ID=
INTACCT_USER_ID=
INTACCT_USER_PASSWORD=

# ---- UKG: scheduled report to SFTP (default) ----
UKG_REPORT_DROP=
# ---- or UKG Pro WFM API ----
UKG_VANITY_URL=
UKG_APP_KEY=
UKG_USERNAME=
UKG_PASSWORD=
UKG_CLIENT_ID=
UKG_CLIENT_SECRET=
UKG_TIMECARD_PATH=

# ---- Inventory export ----
INVENTORY_DROP=

# ---- Marketing ----
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_CUSTOMER_ID=
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
META_API_VERSION=v21.0
GOOGLE_APPLICATION_CREDENTIALS=/path/to/ga4-service-account.json
GA4_PROPERTIES=clearwater:123456789,brandon:987654321
GA4_FORM_EVENT=generate_lead
GA4_BOOKED_EVENT=appointment_booked
SEO_MONTHLY_RETAINER_PER_SITE=0


# ---- Domo demo ----
DOMO_CLIENT_ID=
DOMO_CLIENT_SECRET=
DOMO_API_HOST=api.domo.com
